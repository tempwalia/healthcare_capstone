DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/health_db
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False

# LLM (Groq OpenAI-compatible endpoint) — token-optimized single-model setup.
# Leave LLMGW_API_KEY blank to run the whole platform on deterministic rule-based
# fallbacks (see app/agents/llm.py) — no key required for the app to run end-to-end.
LLM_ENABLED=true
LLMGW_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# LangSmith tracing (optional) — leave LANGSMITH_API_KEY blank to run with
# tracing off, same "no key required" posture as everything else here. These
# are read directly by the langsmith/langchain-core libraries themselves
# (no app.core.config field needed) — real env vars in Docker automatically
# via docker-compose.yml's env_file:, and locally via app/main.py's
# load_dotenv() call.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone
